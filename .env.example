# ============================================================================
# EGBaccloria — Public Frontend Environment Variables (Safe for Client Bundle)
# ============================================================================
# SECURITY RULES:
# 1. NEVER put `service_role` / `sb_secret_*` keys or `OPENROUTER_API_KEY` in
#    this file or any `VITE_*` variable! Anything prefixed with `VITE_` is
#    bundled into browser JavaScript.
# 2. Store `OPENROUTER_API_KEY` exclusively in Supabase Edge Function Secrets:
#      npx supabase secrets set OPENROUTER_API_KEY=sk-or-v1-your-secret-key
# ============================================================================

# Your Supabase Project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred: Your Supabase Publishable Key (Project Settings -> API Keys -> Publishable key `sb_publishable_...`)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Legacy fallback (optional if VITE_SUPABASE_PUBLISHABLE_KEY is set):
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Override full TTS Edge Function URL if using a custom domain
# VITE_SUPABASE_TTS_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/openrouter-tts

# ============================================================================
# Google OAuth Configuration Notes (Supabase Dashboard + Google Cloud Console):
# - Google Cloud Console -> Auth Platform -> Clients -> Authorized redirect URIs:
#     https://<your-project-ref>.supabase.co/auth/v1/callback
# - Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs:
#     http://localhost:5173/**
#     https://<your-production-domain>/**
# ============================================================================
